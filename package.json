{
  "name": "heirloom_scents_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:reuse": "node scripts/audit-reuse.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "knip": "knip",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run audit:tokens && npm run audit:reuse && npm run audit:assets && npm run knip && npm run build && npm run audit:bundle",
    "preview": "node scripts/preview.mjs",
    "media:manifest": "node scripts/build-media-manifest.mjs && prettier --write src/content/media-manifest.ts"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ics": "^3.12.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
